{% from "PreviewFITS-fits-header.html.jinja" import fits_header_table %}
{% from "PreviewFITS-fits-table.html.jinja" import fits_data_table %}

{% macro hdu_name(hdu_row) -%}
  {% set name =   hdu_row["hdu_type"] %}
  {% set header = hdu_row["header"] %}
  {% if header["EXTNAME"] is defined and header["EXTNAME"]|length>0 %}
    {% set name = name ~ " — "~ header["EXTNAME"] %}
  {% endif %}
  {{ name }}
{%- endmacro %}

{% macro hdu_anchor(index) -%}
  {{ "hdu-" ~ index }}
{%- endmacro %}

{% macro fits_image(index, hdu_row, download_info) -%}
  <img
    src="{{ hdu_row['image_link'] }}"
    alt="Preview of {{ download_info['link'] }} HDU {{ index }}"
  />
{%- endmacro %}

{# Actual content that gets rendered #}
<link rel="stylesheet" href="{{ relative_path_modifier }}{{ css_link }}" />
<div class="cambium-PreviewFITS">
  <h1>{{ download_info["link"] }}</h1>

  <div class="cambium-PreviewFITS-summary">
    <p>{% include "PreviewFITS-download-link.html.jinja" %}</p>
    <h2>Contents</h2>
    <ol start="0">
      {% for hdu_row in hdu_entries %}
        <li><a href="#{{ hdu_anchor(loop.index0) }}">{{ hdu_name(hdu_row) }}</a></li>
      {% endfor %}
    </ol>
  </div>

  {% for hdu_row in hdu_entries %}
    <div class="cambium-PreviewFITS-row">
      <h2 id="{{ hdu_anchor(loop.index0) }}">{{ loop.index0 ~ ": " ~ hdu_name(hdu_row) }}</h2>

      {% if hdu_row["preview_type"] == "image" %}
        {{ cambium_wrap(fits_image(loop.index0, hdu_row, download_info), "img") }}
      {% elif hdu_row["preview_type"] == "table" %}
        {{ cambium_wrap(fits_data_table(hdu_row["table_data"], hdu_row["header"], max_preview_rows),"table") }}
      {% else %}
        No preview available for this HDU.
      {% endif %}

      <details>
        <summary>View Header</summary>
        {{ cambium_wrap(fits_header_table(hdu_row["header"])|trim , "table") }}
      </details>
    </div>
  {% endfor %}
</div>
