{#
Macros with names that start with underscores are helpers
Others are meant to be imported and used in other files
#}

{% macro _get_column_name(index, table_header) -%}
  {% set column_name = "Column" ~ (index+1) %}
  {% set name_key, unit_key = "TTYPE"~(index+1), "TUNIT"~(index+1) %}
  {% if table_header[name_key] is defined and table_header[name_key]|length>0 %}
    {% set column_name = table_header[name_key] %}
  {% endif %}
  {% if table_header[unit_key] is defined and table_header[unit_key]|length>0 %}
    {% set column_name = column_name ~ " (" ~ table_header[unit_key] ~")" %}
  {% endif %}
  {{ column_name }}
{%- endmacro %}

{% macro fits_data_table(table_data, table_header, max_preview_rows) -%}
  {# Display tabular data #}
  {% set truncated, total_rows = False, table_data|length %}
  {% set num_cols = table_header["TFIELDS"] %}
  {% if max_preview_rows != none and table_data|length > max_preview_rows %}
    {% set table_data = table_data[:max_preview_rows] %}
    {% set truncated = true %}
  {% endif %}
  <table>
    <caption>
      Data (showing 1-{{ table_data|length }} of {{ total_rows }} rows)
    </caption>
    <thead>
      <tr>
        {% for i in range(num_cols) %}
          <th>{{ _get_column_name(i, table_header) }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in table_data %}
        <tr>
          {% for cell in row %}
            <td>{{ cell }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
      {% if truncated %}
        <tr>
          {% for i in range(num_cols) %}
            <td>...</td>
          {% endfor %}
        </tr>
      {% endif %}
    </tbody>
  </table>
{%- endmacro %}

{% macro fits_header_table(header_obj) -%}
  {# Show a FITS header as a <table> #}
  <table>
    <thead>
      <tr>
        {# Technically the align keyword is deprecated, but Marko uses it and we have CSS that selects it #}
        {# So this doesn't actually rely on browser rendering #}
        <th align="left">Key</th>
        <th align="left">Value</th>
        <th align="left">Comment</th>
      </tr>
    </thead>
    <tbody>
      {% for key, value in header_obj|items %}
        {% set comment = header_obj.comments[key] %}
        {% if key|length>0 or value|length>0 or comment|length>0 %}
          <tr>
            <td align="left">{{ key }}</td>
            <td align="left">{{ value }}</td>
            <td align="left">{{ comment }}</td>
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
{%- endmacro %}

{% macro download_link(download_info) -%}
  {# Link to download the FITS file. Includes a download icon and the filesize. #}
  <a href="./{{ download_info["link"] }}" class="cambium-PreviewFITS-download-link">
    Download ({{ download_info["size"]|filesizeformat }}) {% include "icon-download.html.jinja" %}
  </a>
{%- endmacro %}

{% macro hdu_name(hdu) -%}
  {# Get a "name" for an HDU from it's type and EXTNAME if any #}
  {% set name = hdu["class_name"] %}
  {% set header = hdu["header"] %}
  {% if header["EXTNAME"] is defined and header["EXTNAME"]|length>0 %}
    {% set name = name ~ " — "~ header["EXTNAME"] %}
  {% endif %}
  {{ name }}
{%- endmacro %}

{% macro hdu_anchor(index) -%}
  {# Standardized way to get an anchor (href) for an HDU #}
  {{ "hdu-" ~ index }}
{%- endmacro %}
